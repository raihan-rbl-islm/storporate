{
  "name": "storporate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:verify": "dotenv -e .env.local -- tsx scripts/verify-pgvector.ts",
    "db:check": "dotenv -e .env.local -- drizzle-kit check",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "test:e2e": "rm -rf .next && playwright test",
    "test:e2e:install": "playwright install chromium",
    "secrets:scan": "gitleaks detect --no-banner --redact --config gitleaks.toml --source . --log-opts=\"--all\" --exit-code 2"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "postcss": "^8.5.23",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prettier": "^3",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
