# Public Supabase project URL used by browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anonymous key used by browser and server clients.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Private Supabase service-role key for trusted server-only operations.
SUPABASE_SERVICE_ROLE_KEY=

# Private Postgres connection string used by Drizzle and migrations.
# Get it from: Supabase Dashboard -> Project Settings -> Database ->
# Connection string, "Transaction" pooler (port 6543). Format:
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Never commit a real value. Copy this file to .env.local and fill it in.
DATABASE_URL=

# Public base URL of this app, such as http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public Sentry DSN used to report browser and server errors.
NEXT_PUBLIC_SENTRY_DSN=

# Private Sentry token used when uploading source maps during deployment.
SENTRY_AUTH_TOKEN=

# Private Upstash Redis REST endpoint used by the rate limiter.
UPSTASH_REDIS_REST_URL=

# Private Upstash Redis REST token used by the rate limiter.
UPSTASH_REDIS_REST_TOKEN=

# Private Google AI API key used by matching and outreach features later.
GOOGLE_AI_API_KEY=
